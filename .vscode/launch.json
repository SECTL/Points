{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug MyProject",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/CSMS.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "internalConsoleOptions": "neverOpen",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "启用 GDB 的漂亮打印（让变量显示更清晰）",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build"
        }
    ]
}